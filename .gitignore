# ─── Data (kept out of git — user populates) ──────────────────────────
# Comments explain WHY each is ignored — so a future you knows the intent.
data/resumes/*.pdf          # actual resume PDFs (PII — never commit!)
data/resumes/*.PDF
data/processed/*            # parse cache (regenerable)
data/labeled/*.pdf          # labeled test PDFs (PII)
data/labeled/skill_eval_results.json  # generated report

# Keep directory structure but not contents
!data/resumes/.gitkeep
!data/processed/.gitkeep
!data/labeled/.gitkeep

# ─── OS / Editor junk ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~